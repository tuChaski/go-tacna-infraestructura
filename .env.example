# Development-only settings. Never reuse these values in production.
DB_DATABASE=gotacna_db
DB_USERNAME=postgres
DB_PASSWORD=local-dev-password

# Laravel core
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef0123456789abcdef
APP_URL=http://localhost:8001

# Laravel API Gateway (proxy al core)
GATEWAY_APP_KEY=base64:BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB=
CORE_API_TIMEOUT=30

# Orígenes permitidos por CORS (frontend local y entrada pública del gateway).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8001
# Origen permitido por el servicio de tiempo real.
CORS_ORIGIN=http://localhost:5173

VITE_API_BASE_URL=/api/v1
VITE_WS_URL=http://localhost:8001

# Paths are relative to this infrastructure repository.
BACKEND_PATH=../go-tacna-backend/gotacna-backend-core
GATEWAY_PATH=../go-tacna-backend/gotacna-api-gateway
LOCATION_PATH=../go-tacna-backend/go-tacna-location-service
FRONTEND_PATH=../go-tacna-frontend

DB_PUBLISHED_PORT=5432
GATEWAY_PUBLISHED_PORT=8001
